// Kenangan Coffee Assistant - LDCW6123 Group Project Part 2
// Note: prices are sample prices for demonstration
#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

int main() {
    int choice;
    bool running = true;

    cout << "=== Welcome to Kenangan Coffee ===" << endl;

    while (running) {
        cout << endl;
        cout << "1. Get a drink recommendation" << endl;
        cout << "2. Place an order" << endl;
        cout << "3. Exit" << endl;
        cout << "Choose (1-3): ";
        while (!(cin >> choice) || choice < 1 || choice > 3) {
            cout << "Invalid. Please enter 1, 2 or 3: ";
            cin.clear();
            cin.ignore(1000, '\n');
        }

        switch (choice) {
        case 1: {
            // Drink recommendation
            int mood;
            double budget;

            cout << endl << "What are you in the mood for?" << endl;
            cout << "1. Sweet and creamy" << endl;
            cout << "2. Strong and bold" << endl;
            cout << "3. Something different" << endl;
            cout << "Choose (1-3): ";
            while (!(cin >> mood) || mood < 1 || mood > 3) {
                cout << "Invalid. Please enter 1, 2 or 3: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }

            cout << "Your budget for one drink (RM): ";
            while (!(cin >> budget) || budget <= 0) {
                cout << "Invalid. Please enter a positive number: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }

            if (mood == 1 && budget >= 9.90) {
                cout << "We recommend: Kenangan Latte (RM 9.90)" << endl;
            } else if (mood == 2 && budget >= 7.90) {
                cout << "We recommend: Iced Americano (RM 7.90)" << endl;
            } else if (mood == 3 && budget >= 12.90) {
                cout << "We recommend: Avocado Coffee (RM 12.90)" << endl;
            } else if (budget >= 7.90) {
                cout << "That drink is over your budget. Try Iced Americano (RM 7.90)." << endl;
            } else {
                cout << "Sorry, our cheapest drink is RM 7.90." << endl;
            }
            break;
        }
        case 2: {
            // Order details: drink, size, quantity
            int drink, size, quantity;
            string drinkName;
            double price;

            cout << endl;
            cout << "----- MENU (RM) -----" << endl;
            cout << "1. Kenangan Latte    9.90" << endl;
            cout << "2. Avocado Coffee   12.90" << endl;
            cout << "3. Iced Americano    7.90" << endl;
            cout << "4. Milk Tea          8.90" << endl;
            cout << "5. Chocolate Latte  10.90" << endl;

            cout << "Choose a drink (1-5): ";
            while (!(cin >> drink) || drink < 1 || drink > 5) {
                cout << "Invalid. Please enter 1 to 5: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }

            // Coffee type and price
            switch (drink) {
                case 1: drinkName = "Kenangan Latte";  price = 9.90;  break;
                case 2: drinkName = "Avocado Coffee";  price = 12.90; break;
                case 3: drinkName = "Iced Americano";  price = 7.90;  break;
                case 4: drinkName = "Milk Tea";        price = 8.90;  break;
                default: drinkName = "Chocolate Latte"; price = 10.90; break;
            }

            cout << "Size: 1 = Regular, 2 = Large (+RM 2.00): ";
            while (!(cin >> size) || size < 1 || size > 2) {
                cout << "Invalid. Please enter 1 or 2: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }
            if (size == 2) {
                price = price + 2.00;  // large costs RM 2.00 more
            }

            cout << "How many cups (1-10)? ";
            while (!(cin >> quantity) || quantity < 1 || quantity > 10) {
                cout << "Invalid. Please enter 1 to 10: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }

            double subtotal = price * quantity;

            // Pickup or delivery
            int service;
            double delivery = 0;
            cout << "1 = Pickup, 2 = Delivery: ";
            while (!(cin >> service) || service < 1 || service > 2) {
                cout << "Invalid. Please enter 1 or 2: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }
            if (service == 2) {
                if (subtotal >= 40) {
                    cout << "Free delivery for orders of RM 40 or more!" << endl;
                } else {
                    delivery = 4.00;
                }
            }

            // Promo code
            string code;
            double discount = 0;
            cout << "Promo code (type NO to skip): ";
            cin >> code;
            if (code == "KENANGAN10") {
                discount = subtotal * 0.10;  // 10% off the drinks
                cout << "Promo applied: 10% off!" << endl;
            } else if (code != "NO" && code != "no") {
                cout << "Invalid promo code. No discount given." << endl;
            }

            double total = subtotal - discount + delivery;

            // Order summary
            cout << fixed << setprecision(2);
            cout << endl << "===== ORDER SUMMARY =====" << endl;
            cout << quantity << " x " << drinkName;
            if (size == 1) {
                cout << " (Regular)" << endl;
            } else {
                cout << " (Large)" << endl;
            }
            cout << "Subtotal : RM " << subtotal << endl;
            cout << "Discount : -RM " << discount << endl;
            cout << "Delivery : RM " << delivery << endl;
            cout << "TOTAL    : RM " << total << endl;
            cout << "=========================" << endl;
            cout << "Thank you for choosing Kenangan Coffee!" << endl;
            break;
        }
        case 3:
            cout << "Goodbye! Enjoy your coffee." << endl;
            running = false;
            break;
        }
    }
    return 0;
}
