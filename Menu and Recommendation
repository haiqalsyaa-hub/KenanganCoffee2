#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

int main() {
    int choice;
    bool running = true;

    cout << "=== Welcome to Kenangan Coffee ===" << endl;

    while (running) {
        cout << endl;
        cout << "1. Get a drink recommendation" << endl;
        cout << "2. Place an order" << endl;
        cout << "3. Exit" << endl;
        cout << "Choose (1-3): ";
        while (!(cin >> choice) || choice < 1 || choice > 3) {
            cout << "Invalid. Please enter 1, 2 or 3: ";
            cin.clear();
            cin.ignore(1000, '\n');
        }

        switch (choice) {
        case 1: {
            // Drink recommendation
            int mood;
            double budget;

            cout << endl << "What are you in the mood for?" << endl;
            cout << "1. Sweet and creamy" << endl;
            cout << "2. Strong and bold" << endl;
            cout << "3. Something different" << endl;
            cout << "Choose (1-3): ";
            while (!(cin >> mood) || mood < 1 || mood > 3) {
                cout << "Invalid. Please enter 1, 2 or 3: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }

            cout << "Your budget for one drink (RM): ";
            while (!(cin >> budget) || budget <= 0) {
                cout << "Invalid. Please enter a positive number: ";
                cin.clear();
                cin.ignore(1000, '\n');
            }

            if (mood == 1 && budget >= 9.90) {
                cout << "We recommend: Kenangan Latte (RM 9.90)" << endl;
            } else if (mood == 2 && budget >= 7.90) {
                cout << "We recommend: Iced Americano (RM 7.90)" << endl;
            } else if (mood == 3 && budget >= 12.90) {
                cout << "We recommend: Avocado Coffee (RM 12.90)" << endl;
            } else if (budget >= 7.90) {
                cout << "That drink is over your budget. Try Iced Americano (RM 7.90)." << endl;
            } else {
                cout << "Sorry, our cheapest drink is RM 7.90." << endl;
            }
            break;
        }
        case 2:
            cout << "Ordering coming soon." << endl;
            break;
        case 3:
            cout << "Goodbye! Enjoy your coffee." << endl;
            running = false;
            break;
        }
    }
    return 0;
}
